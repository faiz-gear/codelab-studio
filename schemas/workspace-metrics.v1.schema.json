{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "MetricEventName": {
      "enum": [
        "app_launched",
        "course_opened",
        "preflight_executed",
        "runtime_installed",
        "cmd_block_clicked",
        "cmd_risk_modal_action",
        "cmd_finished",
        "file_tree_open",
        "selection_ai_clicked",
        "ai_mode_switched",
        "acp_permission_decision",
        "verify_chapter_clicked",
        "chapter_marked_done"
      ],
      "type": "string"
    },
    "MetricRecord": {
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "$ref": "#/definitions/MetricEventName"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/definitions/MetricValue"
          },
          "default": {},
          "type": "object"
        },
        "ts": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "ts"
      ],
      "type": "object"
    },
    "MetricValue": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "format": "int32",
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "StorageSchemaVersion": {
      "const": 1,
      "type": "integer"
    }
  },
  "properties": {
    "events": {
      "default": [],
      "items": {
        "$ref": "#/definitions/MetricRecord"
      },
      "type": "array"
    },
    "schemaVersion": {
      "$ref": "#/definitions/StorageSchemaVersion"
    }
  },
  "required": [
    "schemaVersion"
  ],
  "title": "MetricsLog",
  "type": "object"
}
