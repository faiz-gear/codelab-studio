{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AutoCheckRecord": {
      "properties": {
        "checkedAt": {
          "type": "string"
        },
        "latencyMs": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "checkedAt",
        "latencyMs",
        "passed"
      ],
      "type": "object"
    },
    "ChapterProgress": {
      "properties": {
        "autoChecks": {
          "additionalProperties": {
            "$ref": "#/definitions/AutoCheckRecord"
          },
          "default": {},
          "type": "object"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastRunId": {
          "anyOf": [
            {
              "$ref": "#/definitions/RunId"
            },
            {
              "type": "null"
            }
          ]
        },
        "selfChecks": {
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {},
          "type": "object"
        },
        "status": {
          "$ref": "#/definitions/ChapterStatus"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "ChapterStatus": {
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "type": "string"
    },
    "RunId": {
      "type": "string"
    },
    "StorageSchemaVersion": {
      "const": 1,
      "type": "integer"
    }
  },
  "properties": {
    "chapters": {
      "additionalProperties": {
        "$ref": "#/definitions/ChapterProgress"
      },
      "default": {},
      "type": "object"
    },
    "courseId": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "#/definitions/StorageSchemaVersion"
    }
  },
  "required": [
    "courseId",
    "schemaVersion"
  ],
  "title": "ProgressState",
  "type": "object"
}
