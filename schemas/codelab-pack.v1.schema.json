{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ChapterId": {
      "type": "string"
    },
    "CourseChapterRef": {
      "properties": {
        "chapterId": {
          "$ref": "#/definitions/ChapterId"
        },
        "entryFile": {
          "anyOf": [
            {
              "$ref": "#/definitions/RelWorkspacePath"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "chapterId",
        "title"
      ],
      "type": "object"
    },
    "Language": {
      "enum": [
        "js",
        "ts",
        "go",
        "java",
        "python"
      ],
      "type": "string"
    },
    "PackSchemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "RelWorkspacePath": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*/$)(?!.*\\\\)(?!.*//)(?!\\.{1,2}(?:/|$))(?!.*/\\.{1,2}(?:/|$)).+$",
      "type": "string"
    }
  },
  "properties": {
    "author": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "chapters": {
      "default": [],
      "items": {
        "$ref": "#/definitions/CourseChapterRef"
      },
      "type": "array"
    },
    "checksFile": {
      "anyOf": [
        {
          "$ref": "#/definitions/RelWorkspacePath"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "courseId": {
      "type": "string"
    },
    "dependencies": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "entryFile": {
      "$ref": "#/definitions/RelWorkspacePath"
    },
    "language": {
      "$ref": "#/definitions/Language"
    },
    "schemaVersion": {
      "$ref": "#/definitions/PackSchemaVersion"
    },
    "starterDir": {
      "anyOf": [
        {
          "$ref": "#/definitions/RelWorkspacePath"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "title": {
      "type": "string"
    },
    "version": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "courseId",
    "description",
    "entryFile",
    "language",
    "schemaVersion",
    "title"
  ],
  "title": "CourseManifest",
  "type": "object"
}
