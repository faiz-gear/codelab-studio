{
  "schemaVersion": "1.0",
  "courseId": "go-goframe-practice",
  "language": "go",
  "chapters": [
    {
      "chapterId": "ex-0",
      "checks": [
        {
          "id": "s1",
          "title": "POST /tasks 正常创建返回 201，标题为空等非法输入返回 400",
          "type": "self_check"
        },
        {
          "id": "s2",
          "title": "GET /tasks/{id} 命中返回 200，不存在返回 404",
          "type": "self_check"
        },
        {
          "id": "s3",
          "title": "GET /tasks 无任务时返回 200 与空数组 []",
          "type": "self_check"
        },
        {
          "id": "s4",
          "title": "PATCH /tasks/{id} 修改成功返回 200，非法输入返回 400，不存在返回 404",
          "type": "self_check"
        },
        {
          "id": "s5",
          "title": "POST /tasks/{id}/complete 幂等完成返回 200，不存在返回 404",
          "type": "self_check"
        },
        {
          "id": "s6",
          "title": "DELETE /tasks/{id} 删除成功返回 204，不存在返回 404",
          "type": "self_check"
        }
      ]
    },
    {
      "chapterId": "ex-1",
      "requiresDaemon": {
        "label": "go run .",
        "port": 8080,
        "serviceKey": "task-api"
      },
      "checks": [
        {
          "id": "v1",
          "title": "GET /healthz 返回 200 {\"status\":\"ok\"}",
          "type": "http_assert",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8080/healthz"
          },
          "expect": {
            "status": 200,
            "bodyContains": "\"status\":\"ok\"",
            "headers": {
              "content-type": "application/json; charset=utf-8"
            }
          },
          "timeoutSec": 10
        },
        {
          "id": "v2",
          "title": "POST /healthz 返回 405 Method Not Allowed",
          "type": "http_assert",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8080/healthz"
          },
          "expect": {
            "status": 405
          },
          "timeoutSec": 10
        },
        {
          "id": "v3",
          "title": "GET /missing 返回 404 Not Found",
          "type": "http_assert",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8080/missing"
          },
          "expect": {
            "status": 404
          },
          "timeoutSec": 10
        }
      ]
    },
    {
      "chapterId": "ex-2",
      "requiresDaemon": {
        "label": "go run .",
        "port": 8080,
        "serviceKey": "task-api"
      },
      "checks": [
        {
          "id": "v1",
          "title": "GET /tasks 返回 200",
          "type": "http_assert",
          "request": {
            "method": "GET",
            "url": "http://127.0.0.1:8080/tasks"
          },
          "expect": {
            "status": 200
          },
          "timeoutSec": 10
        },
        {
          "id": "v2",
          "title": "POST /tasks 创建任务返回 201 且状态为 pending",
          "type": "http_assert",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8080/tasks",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "{\"title\":\"学习 Go 的 HTTP 服务\"}"
          },
          "expect": {
            "status": 201,
            "bodyContains": "\"status\":\"pending\"",
            "headers": {
              "content-type": "application/json; charset=utf-8"
            }
          },
          "timeoutSec": 10
        },
        {
          "id": "v3",
          "title": "POST /tasks 拒绝空标题并返回 400",
          "type": "http_assert",
          "request": {
            "method": "POST",
            "url": "http://127.0.0.1:8080/tasks",
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "{\"title\":\"\"}"
          },
          "expect": {
            "status": 400
          }
        },
        {
          "id": "v4",
          "title": "GET /tasks/999999 返回 404",
          "type": "http_assert",
          "request": {
            "url": "http://127.0.0.1:8080/tasks/999999"
          },
          "expect": {
            "status": 404
          }
        },
        {
          "id": "s1",
          "title": "已完成内存版任务 CRUD 全流程自测（含 400/404 与幂等完成）",
          "type": "self_check"
        }
      ]
    },
    {
